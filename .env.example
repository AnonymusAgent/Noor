# ─────────────────────────────────────────────────────────────────────────────
# Mobile app (Expo). ONLY `EXPO_PUBLIC_*` values reach the app bundle — they are
# compiled into the shipped binary, so never put a secret here.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the sync API in `server/`. Leave unset and the app stays fully
# local-first: no sign-in, no network calls, everything stored on the device.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# EXPO_PUBLIC_API_URL=https://sync.example.com

# Optional OpenAI-compatible endpoint hosted by your own trusted server. Never
# put provider keys in the mobile app.
# EXPO_PUBLIC_AI_API_URL=https://your-api.example.com/v1/chat/completions
# EXPO_PUBLIC_AI_MODEL=your-server-model-id

# ─────────────────────────────────────────────────────────────────────────────
# Sync server (`server/`). Copy to `server/.env`. These values MUST stay on the
# server — a database URL inside a mobile binary would expose every account.
# ─────────────────────────────────────────────────────────────────────────────

# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# PORT=4000
# HOST=0.0.0.0

# The web app origin allowed by CORS. Set this explicitly in production —
# `*` throws away the protection CORS is meant to give you.
# PUBLIC_ORIGIN=https://app.example.com

# How long a sign-in session (bearer token) stays valid.
# SESSION_TTL_DAYS=90
# LOGIN_CODE_TTL_MINUTES=10
# LOGIN_CODE_MAX_ATTEMPTS=5

# Development only. Echoes the login code in the API response so you can test
# sign-in before a mail provider is wired up. Honoured ONLY when NODE_ENV is not
# `production`. Never enable this in production.
# RETURN_LOGIN_CODE_IN_RESPONSE=true
