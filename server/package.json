{
  "name": "@islamicguide/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sync API for the IslamicGuide mobile app. Never bundled into the client.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/api.test.ts test/clientsync.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
}
